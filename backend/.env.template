# DataTalker environment template — copy to .env and fill in.
# Every DATATALKER_* var is optional unless marked REQUIRED (sensible defaults in core/settings.py).

# --- REQUIRED -----------------------------------------------------------------
# Shared secret clients send as "Authorization: Bearer <key>". Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DATATALKER_API_KEY=

# --- LLM (exactly one provider) -----------------------------------------------
# Google Gemini (default):
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure, vLLM, Ollama, LiteLLM):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Optional -----------------------------------------------------------------
# DATATALKER_DB_DIR=                  # dir server-path SQLite files must live in (default: backend/)
# DATATALKER_MAX_QUERY_ROWS=500       # hard row cap per query
# DATATALKER_STATEMENT_TIMEOUT_SECONDS=30
# DATATALKER_RATE_LIMIT_REQUESTS=30   # per window, per IP; 0 disables
# DATATALKER_RATE_LIMIT_WINDOW_SECONDS=60
# DATATALKER_MAX_PROMPT_TABLES=25     # schema-retrieval budget for huge schemas; 0 = all
# DATATALKER_DATA_DIR=                # connections registry storage (default: backend/data)
# DATATALKER_AUDIT_LOG_PATH=logs/audit.log  # "" disables
# DATATALKER_GOVERNANCE_FILE=         # JSON: {"allowed_tables": [...], "masked_columns": {"t.c": "full|partial|hash"}}
# DATATALKER_SEMANTIC_FILE=           # YAML glossary (see semantic.hospital.yml)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
