# TalkToData Environment Configuration
# Copy this file to .env and fill in your actual values

# --- Required ---

# Gemini AI API Key — required when LLM_PROVIDER is unset or 'gemini'.
# Get one from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API auth key (Required) — clients must send `Authorization: Bearer <this>`.
# Data routes deny all requests until this is set. Use a long random value.
DATATALKER_API_KEY=change_me_to_a_long_random_secret

# Public instance where every visitor brings their own model key? Set false to open the
# data routes (anyone who finds the URL can query whatever it is connected to). Default true.
# DATATALKER_REQUIRE_API_KEY=true

# No LLM key configured at all is also supported: callers send X-LLM-Provider + X-LLM-Key
# per request (the UI does this from Settings -> Model provider key).

# --- LLM provider (EC-01: bring your own model) ---
# LLM_PROVIDER=gemini              # gemini (default) | openrouter | openai
# LLM_MODEL=gemini-1.5-flash       # default for gemini; for openrouter e.g. openai/gpt-4o-mini
# LLM_TEMPERATURE=                 # unset -> provider default
# LLM_API_KEY=                     # required for openrouter and openai
# LLM_BASE_URL=                    # required for openai. Examples:
#   OpenAI:        https://api.openai.com/v1
#   Ollama:        http://localhost:11434/v1
#   vLLM:          http://localhost:8001/v1
#   LiteLLM proxy: http://localhost:4000
#
# OpenRouter needs only the key — its base URL is fixed server-side:
#   LLM_PROVIDER=openrouter
#   LLM_API_KEY=sk-or-v1-...
# Any model that provider serves can then be picked in the UI (Settings -> Model).

# --- Optional ---
# DATATALKER_DB_DIR=               # db_path confinement dir (default: backend/)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOG_LEVEL=INFO
